{
  "name": "skills",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Public Agent Skills collection by Maksym Stoianov, not tied to any single framework.",
  "keywords": [
    "agent-skills",
    "skills",
    "claude-code",
    "gemini-cli",
    "codex",
    "gitea",
    "tea-cli"
  ],
  "homepage": "https://github.com/MaksymStoianov/skills#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaksymStoianov/skills.git"
  },
  "bugs": {
    "url": "https://github.com/MaksymStoianov/skills/issues"
  },
  "author": {
    "name": "Maksym Stoianov",
    "email": "stoianov.maksym@gmail.com",
    "url": "https://maksymstoianov.com"
  },
  "license": "Apache-2.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "LIVE=1 NODE_USE_ENV_PROXY=1 vitest run tests/repo/links.live.test.ts",
    "test:behaviour": "claude plugin eval . --eval-dir tests/skills --allow-tools Bash",
    "test:behaviour:gen": "node scripts/testkit/gen-behaviour.ts",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint-license.ts",
    "skills:init": "npx --yes skills@latest init",
    "skills:add": "npx --yes skills@latest add --agent '*' --yes",
    "skills:list": "npx --yes skills@latest list",
    "skills:find": "npx --yes skills@latest find",
    "skills:use": "npx --yes skills@latest use",
    "skills:update": "npx --yes skills@latest update --yes",
    "skills:remove": "npx --yes skills@latest remove --yes",
    "test:behaviour:validate": "claude plugin eval . --eval-dir tests/skills --max-cost-usd 0 --trust-plugin"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
