.DS_Store
.idea/
.claude/.cc-writes
.claude/settings.local.json
.junie/
__pycache__/
node_modules/

# Fetched copies of other people's pages, kept only so a report can say an
# answer came from a stored copy. Nothing fetched goes into version control;
# the README explaining that does.
/.cache/*
!/.cache/README.md

# The same payloads under the layout a skill resolves from the working
# directory: <project>/sources/, with the raw bodies at sources/.cache/. A
# skill run from here caches into this repository, and that corpus is working
# data for whoever is running it.
/sources/

# `claude plugin eval` writes a full transcript of every run here.
tests/skills/results/
